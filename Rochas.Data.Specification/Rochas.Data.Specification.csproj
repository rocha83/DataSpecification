<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Authors>Renato Rocha</Authors>
    <Company>Renato Rocha</Company>
    <Description>Rochas.Data.Specification - contract/specification orchestrator for the Rochas data toolkit (DapperRepository, BWOQ, SqlWrapper, CacheIndexer)</Description>
    <Copyright>Renato Rocha</Copyright>
    <PackageProjectUrl>https://github.com/rocha83/DataSpecification</PackageProjectUrl>
    <RepositoryUrl>https://github.com/rocha83/DataSpecification</RepositoryUrl>
    <RepositoryType>Git</RepositoryType>
    <PackageTags>specification contract data toolkit dapper generic repository entity entities database sql sqlserver mysql postgresql sqlite cacheable elastic tokenized search bulk persistence parser crud poco orm cqrs builder pattern fluent api bwoq sqlwrapper cacheindexer</PackageTags>
    <PackageLicenseFile>GNUv2_License.txt</PackageLicenseFile>
    <PackageIcon>data-icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Version>2.0.1</Version>
    <PackageReleaseNotes>v2.0.1 - New [Indexable] annotation (IndexSection Title/Body) for lexical indexers (CacheIndexer). v2.0.0 - Rebranded as Rochas.Data.Specification, the contract orchestrator of the data toolkit. Namespace moved to Rochas.Data.Specification.*. New IPersistenceRepository&lt;T&gt; (base persistence contract), IGenericRepository&lt;T&gt; : IPersistenceRepository&lt;T&gt;, IGenericBwoqRepository&lt;T&gt; and IBwoqQueryBuilder&lt;T&gt; exposing the BWOQ grammar (Q/W/G/O/OD) against the repository. Replaces Rochas.DapperRepository.Specification (1.5.2, kept on NuGet for legacy).</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="GNUv2_License.txt">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Update="data-icon.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>