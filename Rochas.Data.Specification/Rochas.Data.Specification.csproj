<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Authors>Renato Rocha</Authors>
    <Company>Renato Rocha</Company>
    <Description>Rochas.Data.Specification - contract/specification orchestrator for the Rochas data toolkit (DapperRepository, BWOQ, SqlWrapper, CacheIndexer)</Description>
    <Copyright>Renato Rocha</Copyright>
    <PackageProjectUrl>https://github.com/rocha83/DataSpecification</PackageProjectUrl>
    <RepositoryUrl>https://github.com/rocha83/DataSpecification</RepositoryUrl>
    <RepositoryType>Git</RepositoryType>
    <PackageTags>specification contract data toolkit dapper generic repository entity entities database sql sqlserver mysql postgresql sqlite cacheable elastic tokenized search bulk persistence parser crud poco orm cqrs builder pattern fluent api bwoq sqlwrapper cacheindexer</PackageTags>
    <PackageLicenseFile>GNUv2_License.txt</PackageLicenseFile>
    <PackageIcon>data-icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Version>1.6.3</Version>
    <PackageReleaseNotes>v1.6.3 - Contract orchestrator for the Rochas data toolkit. Namespace moved to Rochas.Data.Specification.*. IPersistenceRepository&lt;T&gt; (base persistence contract), IGenericRepository&lt;T&gt; : IPersistenceRepository&lt;T&gt;, IGenericBwoqRepository&lt;T&gt; and IBwoqQueryBuilder&lt;T&gt; exposing the BWOQ grammar (Q/W/G/O/OD). ICacheProvider and [Cacheable]/[Indexable] annotations (IndexSection Title/Body). Replaces Rochas.DapperRepository.Specification (1.5.2).</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="GNUv2_License.txt">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Update="data-icon.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>